# Cosmic Query Agent - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM features)
OPENAI_API_KEY=sk-your-key-here

# Optional: anthropic alternative
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Local LLM (LM Studio, Ollama)
USE_LOCAL_LLM=true
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=local-model

# ============================================
# Space-Track.org (free account required)
# Register at: https://www.space-track.org/auth/createAccount
# Required for debris data
# ============================================
SPACETRACK_USER=your-email@example.com
SPACETRACK_PASSWORD=your-password

# ============================================
# Cesium Ion (free tier available)
# Get token at: https://cesium.com/ion/
# Optional - uses default token if not set
# ============================================
CESIUM_ION_TOKEN=your-cesium-token
